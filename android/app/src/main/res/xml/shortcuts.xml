<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon, or ask the phone's assistant, to jump straight into these. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="play"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_play_short"
        android:shortcutLongLabel="@string/sc_play_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="morningbriefing://play"
            android:targetPackage="com.proedit.morningbriefing"
            android:targetClass="com.proedit.morningbriefing.MainActivity" />
    </shortcut>
